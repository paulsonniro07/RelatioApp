# ─── Database ───────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=relatioapp
DB_USER=postgres
DB_PASSWORD=

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=http://localhost:3000
JWT_EXPIRY_MINUTES=60

# ─── Bootstrap Admin (first admin account) ──────────────
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRSTNAME=
BOOTSTRAP_ADMIN_LASTNAME=

# ─── App ────────────────────────────────────────────────
API_PORT=8080
CLIENT_PORT=3000
ASPNETCORE_ENVIRONMENT=Development

# ─── Frontend ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api
# Chart data source: 'api' (ASP.NET backend) or 'local' (browser localStorage —
# zero-backend static deployments like Vercel, no database required)
VITE_DATA_SOURCE=api
